#services .grid .card:nth-child(11) .icon,#services .grid .card:nth-child(11) .apply{background:linear-gradient(135deg,#2563eb,#06b6d4)}
#services .grid .card:nth-child(12) .icon,#services .grid .card:nth-child(12) .apply{background:linear-gradient(135deg,#e11d48,#f97316)}
#services .grid .card:nth-child(13) .icon,#services .grid .card:nth-child(13) .apply{background:linear-gradient(135deg,#334155,#64748b)}
#services .grid .card:nth-child(14) .icon,#services .grid .card:nth-child(14) .apply{background:linear-gradient(135deg,#4f46e5,#2563eb)}
#services .grid .card:nth-child(15) .icon,#services .grid .card:nth-child(15) .apply{background:linear-gradient(135deg,#d97706,#b45309)}
#services .grid .card:nth-child(16) .icon,#services .grid .card:nth-child(16) .apply{background:linear-gradient(135deg,#e11d48,#be123c)}
#services .grid .card:nth-child(17) .icon,#services .grid .card:nth-child(17) .apply{background:linear-gradient(135deg,#db2777,#f43f5e)}
#services .grid .card:nth-child(18) .icon,#services .grid .card:nth-child(18) .apply{background:linear-gradient(135deg,#4f46e5,#7c3aed)}
#services .grid .card:nth-child(19) .icon,#services .grid .card:nth-child(19) .apply{background:linear-gradient(135deg,#0f766e,#059669)}
#services .grid .card:nth-child(20) .icon,#services .grid .card:nth-child(20) .apply{background:linear-gradient(135deg,#2563eb,#4f46e5)}
#services .grid .card:nth-child(21) .icon,#services .grid .card:nth-child(21) .apply{background:linear-gradient(135deg,#64748b,#475569)}
#services .grid .card:nth-child(22) .icon,#services .grid .card:nth-child(22) .apply{background:linear-gradient(135deg,#65a30d,#16a34a)}
#services .grid .card:nth-child(23) .icon,#services .grid .card:nth-child(23) .apply{background:linear-gradient(135deg,#ca8a04,#16a34a)}
#services .grid .card:nth-child(24) .icon,#services .grid .card:nth-child(24) .apply{background:linear-gradient(135deg,#f59e0b,#0ea5e9)}
#services .grid .card:nth-child(25) .icon,#services .grid .card:nth-child(25) .apply{background:linear-gradient(135deg,#0891b2,#0e7490)}
#services .grid .card:nth-child(26) .icon,#services .grid .card:nth-child(26) .apply{background:linear-gradient(135deg,#0f766e,#2563eb)}
#services .grid .card:nth-child(27) .icon,#services .grid .card:nth-child(27) .apply{background:linear-gradient(135deg,#0ea5e9,#6366f1)}
#services .grid .card:nth-child(28) .icon,#services .grid .card:nth-child(28) .apply{background:linear-gradient(135deg,#7c3aed,#ec4899)}

#services .grid .card .apply:hover{
  filter:brightness(1.08);
  transform:translateY(-1px);
}
/* ONLY: Customer Rating widget */
.footer-grid .customer-rating{
  align-self:start;
}
.customer-rating h4{
  margin:0 0 10px;
}
.customer-rating h4 i{
  margin-right:6px;
}
.rating-stars{
  display:flex;
  gap:3px;
}
.rating-stars button{
  border:0;
  background:transparent;
  padding:0 2px;
  font-size:25px;
  line-height:1;
  cursor:pointer;
  color:#94a3b8;
  transition:transform .15s ease,color .15s ease;
}
.rating-stars button:hover,
.rating-stars button.active{
  color:#fbbf24;
  transform:scale(1.08);
}
.rating-note{
  margin-top:7px;
  color:#94a3b8;
  font-size:12px;
}
@media(max-width:800px){
  .customer-rating{margin-bottom:18px}
}
