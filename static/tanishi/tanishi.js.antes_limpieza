  x.style.display = x.style.display === 'none' ? 'block' : 'none';
}
function cerrarNavMovil() {
  document.getElementById('mobileNav').style.display = 'none';
}

// -------------------------------------------------------------------
//  Overlays con click o Escape
// -------------------------------------------------------------------
document.querySelectorAll('.overlay').forEach(o => o.addEventListener('click', e => {
  if (e.target === o) {
    if (o.id === 'applyOverlay') cerrarSolicitud();
    else if (o.id === 'detailsOverlay') cerrarDetalle();
    else cerrarLogin();
  }
}));
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { cerrarSolicitud(); cerrarLogin(); cerrarDetalle(); }
});

// -------------------------------------------------------------------
//  Calificación del cliente
// -------------------------------------------------------------------
(function() {
  const estrellas = document.querySelectorAll('.rating-stars button');
  const nota = document.getElementById('ratingNote');
  if (!estrellas.length || !nota) return;

  estrellas.forEach(star => {
    star.addEventListener('click', function() {
      const valor = Number(this.dataset.rating);
      estrellas.forEach(s => s.classList.toggle('active', Number(s.dataset.rating) <= valor));
      nota.textContent = valor === 1
        ? '¡Gracias por su calificación de 1 estrella!'
        : 'Calificación de ' + valor + ' estrellas seleccionada. ¡Gracias por su opinión!';
      try { localStorage.setItem('tanishi_calificacion_cliente', String(valor)); } catch(e) {}
    });
  });

  try {
    const guardada = Number(localStorage.getItem('tanishi_calificacion_cliente'));
    if (guardada >= 1 && guardada <= 5) {
      estrellas.forEach(s => s.classList.toggle('active', Number(s.dataset.rating) <= guardada));
      nota.textContent = 'Calificación de ' + guardada + ' estrellas seleccionada. ¡Gracias por su opinión!';
    }
  } catch(e) {}
})();

