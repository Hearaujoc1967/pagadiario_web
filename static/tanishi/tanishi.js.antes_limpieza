// -------------------------------------------------------------------
//  Configuración general
// -------------------------------------------------------------------
const CONFIG = {
  API_URL:       '',                    // vacío = mismo origen
  pais:          'Colombia',
  codigoPais:    '+57',
  moneda:        'COP',
  simboloMoneda: '$',
  locale:        'es-CO',
  whatsapp:      '573001234567',
  telefono:      '+573001234567',
  longitudTel:   10,
  prefijoValido: /^[3]\d{9}$/
};

// -------------------------------------------------------------------
//  Estado de sesión
// -------------------------------------------------------------------
let tokenSesion = null;
let rolActual = '';
let usuarioActual = '';
let cacheSolicitudes = [];

document.getElementById('year').textContent = new Date().getFullYear();

// -------------------------------------------------------------------
//  Helper de fetch al API
// -------------------------------------------------------------------
async function api(ruta, opciones = {}) {
  const headers = Object.assign(
    { 'Content-Type': 'application/json' },
    opciones.headers || {}
  );
  if (tokenSesion) headers['Authorization'] = 'Bearer ' + tokenSesion;

  const resp = await fetch(CONFIG.API_URL + ruta, Object.assign({}, opciones, { headers }));
  let datos = null;
  try { datos = await resp.json(); } catch(e) {}
  if (!resp.ok) {
    throw new Error((datos && datos.error) || ('Error HTTP ' + resp.status));
  }
  return datos;
}

// -------------------------------------------------------------------
//  Cargar configuración del servidor
// -------------------------------------------------------------------
async function cargarConfiguracion() {
  try {
    const cfg = await api('/api/configuracion');
    Object.assign(CONFIG, {
      pais:          cfg.pais          || CONFIG.pais,
      codigoPais:    cfg.codigo_pais   || CONFIG.codigoPais,
      moneda:        cfg.moneda        || CONFIG.moneda,
      simboloMoneda: cfg.simbolo_moneda|| CONFIG.simboloMoneda,
      whatsapp:      cfg.whatsapp      || CONFIG.whatsapp,
      telefono:      cfg.telefono_contacto || CONFIG.telefono
    });
    // Actualizar enlaces de contacto del HTML
    document.querySelectorAll('a[href^="tel:"]').forEach(a => {
      a.href = 'tel:' + CONFIG.telefono;
    });
    document.querySelectorAll('a[href*="wa.me/"]').forEach(a => {
      const url = a.href.replace(/wa\.me\/[0-9]+/, 'wa.me/' + CONFIG.whatsapp);
      a.href = url;
    });
  } catch(e) {
    console.warn('No se pudo cargar configuración:', e.message);
  }
}

// -------------------------------------------------------------------
//  Generar ID de solicitud
// -------------------------------------------------------------------
function generarId() {
  const d = new Date();
  const parte = d.getFullYear().toString().slice(-2)
              + String(d.getMonth()+1).padStart(2,'0')
              + String(d.getDate()).padStart(2,'0');
  return 'TF-' + parte + '-' + Math.random().toString(36).slice(2,7).toUpperCase();
}

// -------------------------------------------------------------------
//  Modal de solicitud
// -------------------------------------------------------------------
function abrirSolicitud(tipo) {
  document.getElementById('applyOverlay').style.display = 'flex';
  document.getElementById('applyForm').style.display = 'block';
  document.getElementById('successBox').style.display = 'none';
  document.getElementById('loanType').value = tipo || '';
  document.body.style.overflow = 'hidden';
}
function cerrarSolicitud() {
  document.getElementById('applyOverlay').style.display = 'none';
  document.body.style.overflow = '';
  document.getElementById('applyForm').reset();
}

document.getElementById('applyForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const btn = this.querySelector('button[type=submit]');
  if (btn) { btn.disabled = true; btn.textContent = 'Enviando…'; }

  const telefono = document.getElementById('mobile').value.replace(/\D/g,'');
  if (!CONFIG.prefijoValido.test(telefono)) {
    if (btn) { btn.disabled = false; btn.innerHTML = 'Enviar Solicitud'; }
    alert('Por favor ingrese un número válido de ' + CONFIG.longitudTel + ' dígitos para ' + CONFIG.pais + '.');
    return;
  }

  const solicitud = {
    id:           generarId(),
    nombre:       document.getElementById('name').value.trim(),
    telefono:     telefono,
    codigo_pais:  CONFIG.codigoPais,
    servicio:     document.getElementById('loanType').value,
    monto:        document.getElementById('amount').value.trim() || null,
    ciudad:       document.getElementById('city').value.trim(),
    empleo:       document.getElementById('employment').value,
    mensaje:      document.getElementById('message').value.trim()
  };

  try {
    await api('/api/solicitudes', {
      method: 'POST',
      body: JSON.stringify(solicitud)
    });

    document.getElementById('applyForm').style.display = 'none';
    document.getElementById('successBox').style.display = 'block';
    document.getElementById('leadId').textContent = 'ID de Referencia: ' + solicitud.id;

    const mensajeWA = encodeURIComponent(
      'Hola Tanishi Finance, he enviado una solicitud. Mi ID de referencia es ' + solicitud.id +
      '. Nombre: ' + solicitud.nombre + '. Servicio: ' + solicitud.servicio +
      '. Por favor ayúdenme con el siguiente paso.'
    );
    document.getElementById('successWhatsApp').href =
      'https://wa.me/' + CONFIG.whatsapp + '?text=' + mensajeWA;
  } catch(err) {
    alert('Error al enviar: ' + err.message);
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = 'Enviar Solicitud'; }
  }
});

