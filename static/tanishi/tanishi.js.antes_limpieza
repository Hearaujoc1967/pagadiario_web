// -------------------------------------------------------------------
//  Login / Logout
// -------------------------------------------------------------------
function abrirLogin(rol) {
  rolActual = rol;
  document.getElementById('loginTitle').textContent = (rol === 'Admin' ? 'Administrador' : 'Personal') + ' - Ingreso';
  document.getElementById('loginArea').style.display = 'block';
  document.getElementById('dashboard').style.display = 'none';
  document.getElementById('loginUser').value = '';
  document.getElementById('loginPass').value = '';
  document.getElementById('loginError').textContent = '';
  document.getElementById('loginOverlay').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function cerrarLogin() {
  document.getElementById('loginOverlay').style.display = 'none';
  document.body.style.overflow = '';
}
document.getElementById('loginPass').addEventListener('keydown', e => { if (e.key === 'Enter') hacerLogin(); });

async function hacerLogin() {
  const u = document.getElementById('loginUser').value.trim();
  const p = document.getElementById('loginPass').value;
  if (!u || !p) {
    document.getElementById('loginError').textContent = 'Ingrese usuario y contraseña.';
    return;
  }
  try {
    const r = await api('/api/login', {
      method: 'POST',
      body: JSON.stringify({ usuario: u, clave: p })
    });
    tokenSesion = r.token;
    usuarioActual = r.usuario;
    rolActual = r.rol;
    document.getElementById('loginArea').style.display = 'none';
    document.getElementById('dashboard').style.display = 'block';
    document.getElementById('dashRole').textContent =
      (r.rol === 'admin' ? 'Panel Administrador' : 'Panel Personal') + ' — ' + r.nombre_completo;
    renderDashboard();
  } catch(err) {
    document.getElementById('loginError').textContent = err.message;
  }
}
async function cerrarSesion() {
  try { await api('/api/logout', { method: 'POST' }); } catch(e) {}
  tokenSesion = null;
  usuarioActual = '';
  document.getElementById('dashboard').style.display = 'none';
  document.getElementById('loginArea').style.display = 'block';
}

// -------------------------------------------------------------------
//  Dashboard
// -------------------------------------------------------------------
const ESTADOS = ['Nuevo','Contactado','Documentos','Ingreso','PD','Aprobado','Desembolsado','Rechazado','Cerrado'];

async function renderDashboard() {
  let lista = [];
  try {
    lista = await api('/api/solicitudes');
  } catch(err) {
    document.getElementById('emptyDash').style.display = 'block';
    document.getElementById('emptyDash').textContent = 'Error al cargar: ' + err.message;
    return;
  }
  cacheSolicitudes = lista;

  const hoy = new Date().toISOString().slice(0,10);
  const buscar = (document.getElementById('leadSearch')?.value || '').trim().toLowerCase();
  const filtro = document.getElementById('leadFilter')?.value || '';

  document.getElementById('kTotal').textContent   = lista.length;
  document.getElementById('kToday').textContent   = lista.filter(x => (x.fecha_creacion||'').slice(0,10) === hoy).length;
  document.getElementById('kPending').textContent = lista.filter(x => !['Desembolsado','Rechazado','Cerrado'].includes(x.estado)).length;
  document.getElementById('kDone').textContent    = lista.filter(x => ['Desembolsado','Cerrado'].includes(x.estado)).length;

  const visibles = lista.filter(l => {
    const coincide = !buscar || [l.id, l.nombre, l.telefono, l.servicio]
      .some(v => String(v || '').toLowerCase().includes(buscar));
    return coincide && (!filtro || l.estado === filtro);
  });

  const tb = document.getElementById('leadTable');
  tb.innerHTML = '';
  visibles.forEach(l => {
    const tr = document.createElement('tr');
    [l.id, l.nombre, l.telefono, l.servicio,
     new Date(l.fecha_creacion).toLocaleString(CONFIG.locale)].forEach(v => {
      const td = document.createElement('td');
      td.textContent = v;
      tr.appendChild(td);
    });

    const td = document.createElement('td');
    const wrap = document.createElement('div');
    wrap.className = 'lead-actions';

    const sel = document.createElement('select');
    sel.className = 'status';
    ESTADOS.forEach(s => {
      const o = document.createElement('option');
      o.value = s; o.textContent = s;
      if (s === l.estado) o.selected = true;
      sel.appendChild(o);
    });
    sel.onchange = async () => {
      try {
        await api('/api/solicitudes/' + l.id, {
          method: 'PATCH',
          body: JSON.stringify({ estado: sel.value })
        });
        renderDashboard();
      } catch(err) { alert('Error: ' + err.message); }
    };

    const ver = document.createElement('button');
    ver.className = 'small-btn btn-dark';
    ver.textContent = 'Ver';
    ver.onclick = () => mostrarDetalle(l.id);

    const llamar = document.createElement('a');
    llamar.className = 'small-btn btn-green';
    llamar.textContent = 'Llamar';
    llamar.href = 'tel:' + (l.codigo_pais || CONFIG.codigoPais) + l.telefono;

    wrap.appendChild(sel); wrap.appendChild(ver); wrap.appendChild(llamar);
    td.appendChild(wrap); tr.appendChild(td); tb.appendChild(tr);
  });

  const vacio = document.getElementById('emptyDash');
  vacio.style.display = visibles.length ? 'none' : 'block';
  vacio.textContent = lista.length ? 'Ninguna solicitud coincide.' : 'Aún no hay solicitudes registradas.';
}

function mostrarDetalle(id) {
  const l = cacheSolicitudes.find(x => x.id === id);
  if (!l) return;
  const box = document.getElementById('leadDetails');
  box.innerHTML = '';
  const datos = [
    ['ID Solicitud', l.id],
    ['Nombre',       l.nombre],
    ['Teléfono',     l.telefono],
    ['Servicio',     l.servicio],
    ['Monto',        l.monto || '—'],
    ['Ciudad',       l.ciudad || '—'],
    ['Empleo',       l.empleo || '—'],
    ['Estado',       l.estado],
    ['Creado',       new Date(l.fecha_creacion).toLocaleString(CONFIG.locale)],
    ['Mensaje',      l.mensaje || '—']
  ];
  datos.forEach(([k, v]) => {
    const d = document.createElement('div');
    const b = document.createElement('b'); b.textContent = k;
    const s = document.createElement('span'); s.textContent = v;
    d.appendChild(b); d.appendChild(s);
    box.appendChild(d);
  });
  document.getElementById('detailsOverlay').style.display = 'flex';
}
function cerrarDetalle() {
  document.getElementById('detailsOverlay').style.display = 'none';
}

function exportarCSV() {
  if (!cacheSolicitudes.length) { alert('No hay solicitudes.'); return; }
  const headers = ['ID','Nombre','Teléfono','Servicio','Monto','Ciudad','Empleo','Mensaje','Estado','Fecha'];
  const esc = v => '"' + String(v ?? '').replace(/"/g,'""') + '"';
  const filas = cacheSolicitudes.map(l => [
    l.id, l.nombre, l.telefono, l.servicio, l.monto, l.ciudad, l.empleo,
    l.mensaje, l.estado,
    new Date(l.fecha_creacion).toLocaleString(CONFIG.locale)
  ].map(esc).join(','));
  const blob = new Blob([[headers.map(esc).join(','), ...filas].join('\n')], {type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'tanishi-solicitudes.csv';
  a.click();
  URL.revokeObjectURL(a.href);
}

