<!--begin::Header-->
<div id="kt_header" class="header" data-kt-sticky="true" data-kt-sticky-name="header" data-kt-sticky-offset="{default: '200px', lg: '300px'}">

    <div class="container-xxl d-flex align-items-center justify-content-between" id="kt_header_container">

        <div class="page-title d-flex flex-column align-items-start justify-content-center flex-wrap mt-n5 mt-lg-0 me-lg-2 pb-2 pb-lg-0"
             data-kt-swapper="true"
             data-kt-swapper-mode="prepend"
             data-kt-swapper-parent="{default: '#kt_content_container', lg: '#kt_header_container'}">
            <h1 class="text-dark fw-bold my-0 fs-2">{% block page_title %}Dashboard{% endblock %}</h1>
            <ul class="breadcrumb fw-semibold fs-base my-1">
                <li class="breadcrumb-item text-muted">
                    <a href="{{ url_for('portal') if session.id_nivel == 4 else url_for('dashboard') }}" class="text-muted text-hover-primary">Home</a>
                </li>
                <li class="breadcrumb-item text-muted">{% block breadcrumb_parent %}Pagadiario{% endblock %}</li>
                <li class="breadcrumb-item text-dark">{% block breadcrumb %}Dashboard{% endblock %}</li>
            </ul>
        </div>

        <div class="d-flex d-lg-none align-items-center ms-n4 me-2">
            <div class="btn btn-icon btn-active-icon-primary" id="kt_aside_mobile_toggle">
                <i class="ki-duotone ki-abstract-14 fs-1"><span class="path1"></span><span class="path2"></span></i>
            </div>
            <a href="{{ url_for('portal') if session.id_nivel == 4 else url_for('dashboard') }}" class="d-flex align-items-center">
                <img alt="Logo" src="{{ url_for('static', filename='metronic/media/logos/demo7.svg') }}" class="h-30px" />
            </a>
        </div>

        <div class="d-flex flex-shrink-0">

            <!--begin::Notificaciones-->
{% if session.id_nivel in (1, 2, 3) %}
<!-- CAMPANA ADMIN: Muestra solicitudes pendientes -->
<div class="d-flex align-items-center me-3">
    <div class="btn btn-icon btn-active-color-warning btn-color-gray-600 btn-active-light position-relative h-40px w-40px"
         data-kt-menu-trigger="{default: 'click', lg: 'click'}"
         data-kt-menu-attach="parent"
         data-kt-menu-placement="bottom-end">
        <i class="ki-duotone ki-notification-on fs-2">
            <span class="path1"></span><span class="path2"></span><span class="path3"></span>
        </i>
        {% if total_solicitudes and total_solicitudes > 0 %}
        <span class="bullet bullet-dot bg-danger h-6px w-6px position-absolute translate-middle top-0 start-100 animation-blink"></span>
        {% endif %}
    </div>
    <div class="menu menu-sub menu-sub-dropdown menu-column w-350px w-lg-375px" data-kt-menu="true">
        <div class="d-flex flex-column bgi-no-repeat rounded-top" style="background-image:url('{{ url_for('static', filename='metronic/media/misc/menu-header-bg.jpg') }}')">
            <h3 class="text-white fw-semibold px-9 mt-10 mb-6">
                Solicitudes
                <span class="fs-8 opacity-75 ps-3">{{ total_solicitudes }} pendiente(s)</span>
            </h3>
        </div>
        <div class="scroll-y mh-325px my-5 px-8">
            {% if total_solicitudes and total_solicitudes > 0 %}
            <div class="d-flex flex-stack py-4">
                <div class="d-flex align-items-center">
                    <div class="symbol symbol-35px me-4">
                        <span class="symbol-label bg-light-warning">
                            <i class="ki-duotone ki-notification-on fs-2 text-warning">
                                <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                            </i>
                        </span>
                    </div>
                    <div class="mb-0 me-2">
                        <a href="{{ url_for('solicitudes') }}" class="fs-6 text-gray-800 text-hover-primary fw-bold">
                            Tienes {{ total_solicitudes }} solicitud(es) pendiente(s)
                        </a>
                        <div class="text-gray-400 fs-7">Haz clic para revisarlas</div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="text-center py-10">
                <i class="ki-duotone ki-check-circle fs-3x text-success mb-3">
                    <span class="path1"></span><span class="path2"></span>
                </i>
                <p class="text-muted fs-7">No hay solicitudes pendientes</p>
            </div>
            {% endif %}
        </div>
        <div class="py-3 text-center border-top">
            <a href="{{ url_for('solicitudes') }}" class="btn btn-color-gray-600 btn-active-color-primary">
                Ver todas
                <i class="ki-duotone ki-arrow-right fs-5">
                    <span class="path1"></span><span class="path2"></span>
                </i>
            </a>
        </div>
    </div>
</div>

{% elif session.id_nivel == 4 %}
<!-- CAMPANA CLIENTE: Dropdown de notificaciones (patrón Metronic) -->
<div class="d-flex align-items-center me-3">
    <div class="btn btn-icon btn-active-color-primary btn-color-gray-600 btn-active-light position-relative h-40px w-40px"
         data-kt-menu-trigger="click"
         data-kt-menu-overflow="true"
         data-kt-menu-placement="bottom-end"
         data-bs-toggle="tooltip"
         data-bs-placement="bottom"
         data-bs-dismiss="click"
         title="Notificaciones">
        <i class="ki-duotone ki-notification-on fs-2">
            <span class="path1"></span><span class="path2"></span><span class="path3"></span>
        </i>
        {% if notif_no_leidas and notif_no_leidas > 0 %}
        <span class="bullet bullet-dot bg-danger h-6px w-6px position-absolute translate-middle top-0 start-100 animation-blink"></span>
        {% endif %}
    </div>
    <div class="menu menu-sub menu-sub-dropdown menu-column w-350px w-lg-375px" data-kt-menu="true">
        <div class="d-flex flex-column bgi-no-repeat rounded-top" style="background-image:url('{{ url_for('static', filename='metronic/media/misc/menu-header-bg.jpg') }}')">
            <h3 class="text-white fw-semibold px-9 mt-10 mb-6">
                Notificaciones
                <span class="fs-8 opacity-75 ps-3">{{ notif_no_leidas or 0 }} nueva(s)</span>
            </h3>
        </div>
        <div class="scroll-y mh-325px my-5 px-8">
            <div class="text-center py-10">
                <i class="ki-duotone ki-notification-on fs-3x text-muted mb-3">
                    <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                </i>
                <p class="text-muted fs-7">Tienes {{ notif_no_leidas or 0 }} notificación(es)</p>
            </div>
        </div>
        <div class="py-3 text-center border-top">
            <a href="{{ url_for('notificaciones_cliente') }}" class="btn btn-color-gray-600 btn-active-color-primary">
                Ver todas
                <i class="ki-duotone ki-arrow-right fs-5">
                    <span class="path1"></span><span class="path2"></span>
                </i>
            </a>
        </div>
    </div>
</div>
{% endif %}
<!--end::Notificaciones-->

            <div class="d-flex align-items-center ms-3">
                <a href="#" class="btn btn-icon flex-center bg-body btn-color-gray-600 btn-active-color-primary h-40px"
                   data-kt-menu-trigger="{default:'click', lg: 'hover'}"
                   data-kt-menu-attach="parent"
                   data-kt-menu-placement="bottom-end">
                    <i class="ki-duotone ki-night-day theme-light-show fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span></i>
                    <i class="ki-duotone ki-moon theme-dark-show fs-2"><span class="path1"></span><span class="path2"></span></i>
                </a>
                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-title-gray-700 menu-icon-gray-500 menu-active-bg menu-state-color fw-semibold py-4 fs-base w-150px" data-kt-menu="true" data-kt-element="theme-mode-menu">
                    <div class="menu-item px-3 my-0">
                        <a href="#" class="menu-link px-3 py-2" data-kt-element="mode" data-kt-value="light">
                            <span class="menu-icon" data-kt-element="icon"><i class="ki-duotone ki-night-day fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span></i></span>
                            <span class="menu-title">Light</span>
                        </a>
                    </div>
                    <div class="menu-item px-3 my-0">
                        <a href="#" class="menu-link px-3 py-2" data-kt-element="mode" data-kt-value="dark">
                            <span class="menu-icon" data-kt-element="icon"><i class="ki-duotone ki-moon fs-2"><span class="path1"></span><span class="path2"></span></i></span>
                            <span class="menu-title">Dark</span>
                        </a>
                    </div>
                    <div class="menu-item px-3 my-0">
                        <a href="#" class="menu-link px-3 py-2" data-kt-element="mode" data-kt-value="system">
                            <span class="menu-icon" data-kt-element="icon"><i class="ki-duotone ki-screen fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span></i></span>
                            <span class="menu-title">System</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center ms-3" id="kt_header_user_menu_toggle">
                <div class="cursor-pointer symbol symbol-40px"
                     data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
                     data-kt-menu-attach="parent"
                     data-kt-menu-placement="bottom-end"
                     data-bs-dismiss="click">
                    <img src="{{ url_for('static', filename='metronic/media/avatars/300-1.jpg') }}" alt="user" />
                </div>
                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-4 fs-6 w-275px" data-kt-menu="true">
                    <div class="menu-item px-3">
                        <div class="menu-content d-flex align-items-center px-3">
                            <div class="symbol symbol-50px me-5">
                                <img alt="Avatar" src="{{ url_for('static', filename='metronic/media/avatars/300-1.jpg') }}" />
                            </div>
                            <div class="d-flex flex-column">
                                {% if session.id_nivel in (1, 2, 3) %}
                                <div class="fw-bold d-flex align-items-center fs-5">
                                    {{ session.nombre or 'Administrador' }}
                                    <span class="badge badge-light-success fw-bold fs-8 px-2 py-1 ms-2">Admin</span>
                                </div>
                                <a href="#" class="fw-semibold text-muted text-hover-primary fs-7">admin@pagadiario.com</a>
                                {% elif session.id_nivel == 4 %}
                                <div class="fw-bold d-flex align-items-center fs-5">
                                    {{ session.cliente_nombre or 'Cliente' }}
                                    <span class="badge badge-light-primary fw-bold fs-8 px-2 py-1 ms-2">Cliente</span>
                                </div>
                                <a href="#" class="fw-semibold text-muted text-hover-primary fs-7">Cédula: {{ session.cliente_dni or '-' }}</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="separator my-2"></div>
                    {# ====== SECCIÓN ADMIN ====== #}
                    {% if session.id_nivel in (1, 2, 3) %}
                    <div class="menu-item px-5">
                        <a href="{{ url_for('dashboard') }}" class="menu-link px-5">📊 Mi Dashboard</a>
                    </div>
                    <div class="menu-item px-5">
                        <a href="{{ url_for('solicitudes') }}" class="menu-link px-5">📋 Solicitudes</a>
                    </div>
                    <div class="menu-item px-5">
                        <a href="{{ url_for('clientes_inactivos') }}" class="menu-link px-5">👥 Clientes Inactivos</a>
                    </div>
                    {% endif %}

                    {# ====== SECCIÓN CLIENTE ====== #}
                    {% if session.id_nivel == 4 %}
                    <div class="menu-item px-5">
                        <a href="{{ url_for('mi_perfil') }}" class="menu-link px-5">👤 Mi Perfil</a>
                    </div>
                    <div class="menu-item px-5">
                        <a href="{{ url_for('cambiar_password') }}" class="menu-link px-5">🔑 Cambiar Contraseña</a>
                    </div>
                    <div class="menu-item px-5">
                        <a href="{{ url_for('eliminar_cuenta') }}" class="menu-link px-5 text-danger">⚠️ Eliminar Cuenta</a>
                    </div>
                    {% endif %}

                    <div class="separator my-2"></div>
                    <div class="menu-item px-5">
                        <a href="{{ url_for('logout') }}" class="menu-link px-5">Cerrar Sesión</a>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
<!--end::Header-->