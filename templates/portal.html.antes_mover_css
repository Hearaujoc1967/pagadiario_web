{% extends "base_cliente.html" %}

{% block title %}Mi Portal - Pagadiario{% endblock %}
{% block page_title %}Mi Portal{% endblock %}
{% block breadcrumb %}Mis Préstamos{% endblock %}

{% block content %}

<!-- ============================================== -->
<!-- BANNER DE ADVERTENCIA: CRÉDITO VIGENTE / MORA -->
<!-- ============================================== -->
<!-- FLASH DE BIENVENIDA (se desvanece) -->
<div id="flash-bienvenida" class="flash-bienvenida">
    <div class="d-flex align-items-center">
        <div class="symbol symbol-45px me-3">
            <span class="symbol-label bg-light-primary text-primary fw-bold fs-4">
                {{ (cliente_nombre or 'C')[0]|upper }}
            </span>
        </div>
        <div>
            <div class="text-dark fw-bold fs-6">¡Hola, {{ cliente_nombre }}!</div>
            <div class="text-muted fs-8">Cédula: {{ cliente_dni }}</div>
        </div>
    </div>
</div>

<!-- TOAST GENÉRICO (para mensajes de advertencia/éxito/error) -->
<div id="toast-generico" class="toast-generico" style="display:none;">
    <button type="button" class="toast-cerrar" onclick="cerrarToast()">✕</button>
    <div class="toast-icono">
        <span class="symbol-label" id="toast-icon-bg">
            <i class="ki-duotone ki-information-5 fs-1" id="toast-icon">
                <span class="path1"></span><span class="path2"></span><span class="path3"></span>
            </i>
        </span>
    </div>
    <div class="toast-titulo" id="toast-titulo">Título</div>
    <div class="toast-mensaje" id="toast-mensaje">Mensaje</div>
</div>

{% raw %}
<style>
.flash-bienvenida {
    position: fixed;
    top: 70px;
    left: 50%;
    transform: translateX(-50%);
    background: white;
    border: 1px solid #e4e6ef;
    border-radius: 12px;
    padding: 12px 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    z-index: 9999;
    opacity: 0;

<!-- TOAST DE CRÉDITO VIGENTE / MORA (emergente, color dorado) -->
{% if tiene_prestamo_activo %}
<div id="flash-credito-vigente" class="flash-credito-vigente">
    <div class="d-flex align-items-center">
        <div class="symbol symbol-45px me-3">
            <span class="symbol-label fw-bold fs-3" style="background: #07111f; color: #f5c542;">
                <i class="ki-duotone ki-information-5 fs-2" style="color:#f5c542;"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
            </span>
        </div>
        <div>
            {% if esta_en_mora %}
            <div class="fw-bold fs-6" style="color:#f5c542;">Estás en mora ({{ dias_mora }} día(s))</div>
            <div class="fs-7" style="color:#cbd5e1;">Cancela tu deuda actual para poder solicitar un nuevo préstamo.</div>
            {% else %}
            <div class="fw-bold fs-6" style="color:#f5c542;">Tienes un crédito vigente</div>
            <div class="fs-7" style="color:#cbd5e1;">Préstamo #{{ prestamo_activo_info.id }} con saldo de ${{ "{:,.0f}".format(prestamo_activo_info.saldo) }}. Cancélalo antes de solicitar uno nuevo.</div>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}
    animation: flashIn 0.4s ease-out forwards, flashOut 0.4s ease-in 4s forwards;
    max-width: 420px;
}
[data-bs-theme="dark"] .flash-bienvenida {
    background: #1e1e2d;
    border-color: #2b2b40;
}
@keyframes flashIn {
    from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}
@keyframes flashOut {
    from { opacity: 1; transform: translateX(-50%) translateY(0); }
    to   { opacity: 0; transform: translateX(-50%) translateY(-20px); }
}

/* === TOAST GENÉRICO === */
.toast-generico {
    position: fixed;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffffff;
    border: none;
    border-radius: 16px;
    padding: 24px 30px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.25);
    z-index: 99999;
    opacity: 0;
    transition: opacity 0.3s ease;
    max-width: 460px;
    width: calc(100% - 40px);
    cursor: pointer;
    text-align: center;
}
.toast-generico.toast-visible {
    opacity: 1;
}
[data-bs-theme="dark"] .toast-generico {
    background: #2a2a3d;
    box-shadow: 0 10px 40px rgba(0,0,0,0.6);
}

/* Ícono */
.toast-generico .toast-icono {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
}
.toast-generico .toast-icono .symbol-label {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}
.toast-advertencia .toast-icono .symbol-label { background: #fff4de; color: #ffa800; }
.toast-exito       .toast-icono .symbol-label { background: #e8fff3; color: #50cd89; }
.toast-error       .toast-icono .symbol-label { background: #fff5f8; color: #f1416c; }
[data-bs-theme="dark"] .toast-advertencia .toast-icono .symbol-label { background: #4a3a13; color: #ffc700; }
[data-bs-theme="dark"] .toast-exito       .toast-icono .symbol-label { background: #0f3a25; color: #50cd89; }
[data-bs-theme="dark"] .toast-error       .toast-icono .symbol-label { background: #4a101c; color: #f1416c; }

/* Texto */
.toast-generico .toast-titulo {
    font-size: 1.15rem;
    font-weight: 700;
    color: #181c32;
    margin-bottom: 8px;
}
.toast-generico .toast-mensaje {
    font-size: 0.95rem;
    color: #5e6278;
    line-height: 1.5;
}
[data-bs-theme="dark"] .toast-generico .toast-titulo {
    color: #ffffff;
}
[data-bs-theme="dark"] .toast-generico .toast-mensaje {
    color: #b5b5c3;
}

/* Botón de cerrar (X) arriba a la derecha */
.toast-generico .toast-cerrar {
    position: absolute;
    top: 10px;
    right: 10px;
    background: transparent;
    border: none;
    color: #a1a5b7;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 5px;
    line-height: 1;
}
.toast-generico .toast-cerrar:hover {
    color: #f1416c;
}

</style>
{% endraw %}

{% raw %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var flash = document.getElementById('flash-bienvenida');
    if (flash) {
        setTimeout(function() {
            if (flash.parentNode) flash.parentNode.removeChild(flash);
        }, 4500);
    }
});
</script>
{% endraw %}

<!-- SOLICITAR NUEVO PRÉSTAMO (STEPPER) -->
<div class="card mb-5 mb-xl-8" id="card-solicitud">
    <div class="card-header border-0 pt-5 pb-3">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">Solicitar Nuevo Préstamo</span>
            <span class="text-muted mt-1 fw-semibold fs-7">Completa los pasos y envía tu solicitud</span>
        </h3>
    </div>
    <div class="card-body py-5">

        <!-- STEPPER VISUAL -->
        <div class="d-flex justify-content-between align-items-center mb-8 position-relative">
            <div class="position-absolute top-50 start-0 end-0" style="height: 4px; background: #e4e6ef; z-index: 1;"></div>
            <div class="position-absolute top-50 start-0 bg-primary" id="stepper-progress" style="height: 4px; z-index: 1; width: 0%; transition: width 0.3s;"></div>

            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="stepper-circle active" id="step-circle-1">1</div>
                <span class="mt-2 fw-bold fs-8" id="step-text-1">Cotizar</span>
            </div>
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="stepper-circle" id="step-circle-2">2</div>
                <span class="mt-2 fw-bold fs-8 text-muted" id="step-text-2">Datos</span>
            </div>
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="stepper-circle" id="step-circle-3">3</div>
                <span class="mt-2 fw-bold fs-8 text-muted" id="step-text-3">Seguridad</span>
            </div>
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="stepper-circle" id="step-circle-4">4</div>
                <span class="mt-2 fw-bold fs-8 text-muted" id="step-text-4">Banco</span>
            </div>
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="stepper-circle" id="step-circle-5">5</div>
                <span class="mt-2 fw-bold fs-8 text-muted" id="step-text-5">Enviar</span>
            </div>
        </div>

        <!-- PASO 1: COTIZAR -->
        <div class="step-content" id="paso-1">
            <h4 class="text-dark fw-bold mb-2">¿Cuánto necesitas?</h4>
            <p class="text-muted fs-7 mb-6">Elige el monto y plazo para tu crédito.</p>

            <div class="mb-6">
                <label class="form-label fw-bold">Monto solicitado</label>
                <div class="text-center mb-4">
                    <span class="text-primary fw-bolder" style="font-size: 38px;" id="display-monto">$500.000</span>
                </div>
                <input type="range" class="form-range" id="slider-monto" min="50000" max="20000000" step="50000" value="500000">
                <div class="d-flex justify-content-between mt-2">
                    <span class="text-muted fs-8">Mín: $50.000</span>
                    <span class="text-muted fs-8">Máx: $20.000.000</span>
                </div>
                <div class="d-flex gap-2 mt-4 flex-wrap" id="chips-monto">
                    <button type="button" class="btn btn-sm btn-light-primary chip-monto" data-val="100000">$100.000</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-monto" data-val="500000">$500.000</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-monto" data-val="1000000">$1.000.000</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-monto" data-val="5000000">$5.000.000</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-monto" data-val="10000000">$10.000.000</button>
                </div>
            </div>

            <div class="mb-6">
                <label class="form-label fw-bold">Plazo (días)</label>
                <div class="d-flex gap-2 flex-wrap" id="chips-plazo">
                    <button type="button" class="btn btn-sm btn-light-primary chip-plazo" data-val="7">7 días</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-plazo" data-val="14">14 días</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-plazo" data-val="21">21 días</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-plazo active" data-val="30">30 días</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-plazo" data-val="45">45 días</button>
                    <button type="button" class="btn btn-sm btn-light-primary chip-plazo" data-val="60">60 días</button>
                </div>
            </div>

            <div class="bg-light-primary rounded p-5 mb-5">
                <h5 class="text-primary fw-bold mb-4">📊 Resumen del Préstamo</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold" style="color:#cbd5e1;">Monto:</span>
                    <span class="text-dark fw-bold" id="r-monto">$500.000</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold" style="color:#cbd5e1;">Interés (20%):</span>
                    <span class="text-dark fw-bold" id="r-interes">$100.000</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold" style="color:#cbd5e1;">Total a pagar:</span>
                    <span class="text-primary fw-bolder fs-4" id="r-total">$600.000</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="fw-semibold" style="color:#cbd5e1;">Cuota diaria:</span>
                    <span class="text-success fw-bold" id="r-cuota">$20.000</span>
                </div>
            </div>

            <button type="button" class="btn btn-primary w-100" onclick="irPaso(2)">Continuar →</button>
        </div>

        <!-- PASO 2: DATOS -->
        <div class="step-content d-none" id="paso-2">
            <h4 class="text-dark fw-bold mb-2">Tus datos</h4>
            <p class="text-muted fs-7 mb-6">Confirma tu información personal.</p>

            <div class="mb-4">
                <label class="form-label fw-bold">DNI / Cédula</label>
                <input type="text" class="form-control" id="dni" value="{{ cliente_dni }}" readonly>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Nombre completo</label>
                <input type="text" class="form-control" id="nombre" value="{{ cliente_nombre }}" readonly>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Teléfono</label>
                <input type="tel" class="form-control" id="telefono" 
                       value="{{ cliente_datos.telf or '' }}" 
                       placeholder="Ej: 3101234567" required>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Correo electrónico</label>
                <input type="email" class="form-control" id="email" 
                       value="{{ cliente_datos.email or '' }}" 
                       placeholder="tucorreo@ejemplo.com" required>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Ingreso mensual</label>
                <input type="number" class="form-control" id="ingreso" 
                       value="{{ cliente_datos.ingreso_mensual or '' }}" 
                       placeholder="Ej: 2000000" required>
            </div>
            
            <div class="mb-6">
                <label class="form-label fw-bold">Motivo del préstamo</label>
                <select class="form-select" id="motivo" required>
                    <option value="">Selecciona una opción...</option>
                    <option value="Consolidación de deudas">Consolidación de deudas</option>
                    <option value="Capital de trabajo / Negocio">Capital de trabajo / Negocio</option>
                    <option value="Gastos médicos">Gastos médicos</option>
                    <option value="Educación">Educación</option>
                    <option value="Vivienda">Vivienda</option>
                    <option value="Libre inversión">Libre inversión</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light" onclick="irPaso(1)">← Volver</button>
                <button type="button" class="btn btn-primary flex-grow-1" onclick="enviarDatos()">Continuar →</button>
            </div>
        </div>

        <!-- PASO 3: SEGURIDAD -->
        <div class="step-content d-none" id="paso-3">
            <div class="text-center mb-5">
                <div class="symbol symbol-60px mb-4">
                    <span class="symbol-label bg-light-warning">
                        <i class="ki-duotone ki-lock fs-2x text-warning"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                    </span>
                </div>
                <h4 class="text-dark fw-bold mb-2">Verificación de Seguridad</h4>
                <p class="text-muted fs-7">¿Cómo quieres recibir tu código de 6 dígitos?</p>
            </div>

            <!-- 3 PESTAÑAS DE CANAL (horizontal) -->
            <div class="d-flex flex-nowrap gap-2 mx-auto mb-5" style="max-width: 480px;">
                <button type="button" class="btn btn-sm btn-color-gray-600 btn-active btn-active-success py-3 px-2 flex-fill canal-btn" data-canal="whatsapp" style="font-size: 0.85rem;">
                    <i class="ki-duotone ki-whatsapp fs-3 d-block d-sm-inline me-sm-1"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                    <span class="d-none d-sm-inline">WhatsApp</span>
                    <span class="d-sm-none">WA</span>
                </button>
                <button type="button" class="btn btn-sm btn-color-gray-600 btn-active btn-active-warning py-3 px-2 flex-fill canal-btn" data-canal="sms" style="font-size: 0.85rem;">
                    <i class="ki-duotone ki-sms fs-3 d-block d-sm-inline me-sm-1"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                    <span class="d-none d-sm-inline">SMS</span>
                    <span class="d-sm-none">SMS</span>
                </button>
                <button type="button" class="btn btn-sm btn-color-gray-600 btn-active btn-active-primary py-3 px-2 flex-fill canal-btn" data-canal="email" style="font-size: 0.85rem;">
                    <i class="ki-duotone ki-sms fs-3 d-block d-sm-inline me-sm-1"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                    <span class="d-none d-sm-inline">Email</span>
                    <span class="d-sm-none">Mail</span>
                </button>
            </div>

            <!-- CONTACTO (se actualiza según pestaña) -->
            <div class="text-center mb-6">
                <p class="text-muted fs-7 mb-1" id="canal-descripcion">👆 Elige un canal arriba para recibir tu código</p>
                <p class="text-dark fw-bold fs-5 mb-0" id="contacto-display">-</p>
            </div>

            <div class="d-flex justify-content-center gap-2 mb-6" style="flex-wrap: nowrap;">
                <input type="text" maxlength="1" class="form-control text-center fw-bolder fs-2 otp-input" id="otp-1" style="width: 45px; height: 60px; padding: 0;">
                <input type="text" maxlength="1" class="form-control text-center fw-bolder fs-2 otp-input" id="otp-2" style="width: 45px; height: 60px; padding: 0;">
                <input type="text" maxlength="1" class="form-control text-center fw-bolder fs-2 otp-input" id="otp-3" style="width: 45px; height: 60px; padding: 0;">
                <input type="text" maxlength="1" class="form-control text-center fw-bolder fs-2 otp-input" id="otp-4" style="width: 45px; height: 60px; padding: 0;">
                <input type="text" maxlength="1" class="form-control text-center fw-bolder fs-2 otp-input" id="otp-5" style="width: 45px; height: 60px; padding: 0;">
                <input type="text" maxlength="1" class="form-control text-center fw-bolder fs-2 otp-input" id="otp-6" style="width: 45px; height: 60px; padding: 0;">
            </div>

            <div class="text-center mb-5">
                <span class="text-muted fs-7">¿No recibiste el código? </span>
                <a href="#" class="text-primary fw-bold fs-7" onclick="event.preventDefault(); reenviarOTP();">Reenviar</a>
                <span class="text-muted fs-7 ms-2" id="timer-otp">(45s)</span>
            </div>

            <div class="bg-light-info rounded p-3 mb-5 text-center">
                <i class="ki-duotone ki-check-circle fs-2x text-success mb-2">
                    <span class="path1"></span><span class="path2"></span>
                </i>
                <p class="text-success fw-bold fs-7 mb-0" id="mensaje-envio">Código enviado</p>
                <strong class="d-none" id="codigo-dev">------</strong>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light" onclick="irPaso(2)">← Volver</button>
                <button type="button" class="btn btn-primary flex-grow-1" onclick="verificarOTP()">Validar Código →</button>
            </div>
        </div>

        <!-- PASO 4: BANCO -->
        <div class="step-content d-none" id="paso-4">
            <h4 class="text-dark fw-bold mb-2">Cuenta de desembolso</h4>
            <p class="text-muted fs-7 mb-6">¿Dónde quieres recibir el dinero?</p>

            <div class="row g-3 mb-6" id="bancos-container">
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="Efectivo" id="banco-efectivo" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-efectivo">
                        <span class="fs-2 mb-2">💵</span>
                        <span class="fw-bold fs-7">Efectivo</span>
                    </label>
                </div>
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="Nequi" id="banco-nequi" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-nequi">
                        <span class="fs-2 mb-2">🟣</span>
                        <span class="fw-bold fs-7">Nequi</span>
                    </label>
                </div>
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="Daviplata" id="banco-daviplata" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-daviplata">
                        <span class="fs-2 mb-2">🔴</span>
                        <span class="fw-bold fs-7">Daviplata</span>
                    </label>
                </div>
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="Bancolombia" id="banco-bancolombia" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-bancolombia">
                        <span class="fs-2 mb-2">🟡</span>
                        <span class="fw-bold fs-7">Bancolombia</span>
                    </label>
                </div>
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="BBVA" id="banco-bbva" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-bbva">
                        <span class="fs-2 mb-2">🔵</span>
                        <span class="fw-bold fs-7">BBVA</span>
                    </label>
                </div>
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="Banco de Bogotá" id="banco-bogota" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-bogota">
                        <span class="fs-2 mb-2">🔷</span>
                        <span class="fw-bold fs-7">Banco de Bogotá</span>
                    </label>
                </div>
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="Davivienda" id="banco-davivienda" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-davivienda">
                        <span class="fs-2 mb-2">🔴</span>
                        <span class="fw-bold fs-7">Davivienda</span>
                    </label>
                </div>
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="Banco de Occidente" id="banco-occidente" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-occidente">
                        <span class="fs-2 mb-2">🔵</span>
                        <span class="fw-bold fs-7">Banco de Occidente</span>
                    </label>
                </div>
                <div class="col-6 col-md-4">
                    <input type="radio" name="banco" value="Efecty" id="banco-efecty" class="btn-check">
                    <label class="btn btn-outline btn-outline-dashed d-flex flex-column align-items-center py-4 w-100" for="banco-efecty">
                        <span class="fs-2 mb-2">🟢</span>
                        <span class="fw-bold fs-7">Efecty</span>
                    </label>
                </div>
            </div>

            <div class="mb-6">
                <label class="form-label fw-bold">Número de cuenta / Celular</label>
                <input type="text" class="form-control" id="numero-cuenta" placeholder="Ingresa el número donde recibirás el dinero" required>
                <span class="text-muted fs-8 mt-1 d-block">Este es el número donde el prestamista hará el desembolso.</span>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light" onclick="irPaso(3)">← Volver</button>
                <button type="button" class="btn btn-primary flex-grow-1" onclick="enviarBanco()">Continuar →</button>
