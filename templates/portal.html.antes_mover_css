            <h4 class="text-dark fw-bold mb-2">Confirmar y Enviar</h4>
            <p class="text-muted fs-7 mb-6">Revisa los datos antes de enviar.</p>

            <div class="bg-light rounded p-5 mb-5">
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted">Monto solicitado:</span>
                    <span class="text-dark fw-bold" id="conf-monto">-</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted">Plazo:</span>
                    <span class="text-dark fw-bold" id="conf-plazo">-</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="fw-semibold" style="color:#cbd5e1;">Cuota diaria:</span>
                    <span class="text-success fw-bold" id="conf-cuota">-</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="fw-semibold" style="color:#cbd5e1;">Total a pagar:</span>
                    <span class="text-primary fw-bolder" id="conf-total">-</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Banco destino:</span>
                    <span class="text-dark fw-bold" id="conf-banco">-</span>
                </div>
            </div>

            <div class="form-check mb-5">
                <input class="form-check-input" type="checkbox" id="acepto-terminos">
                <label class="form-check-label text-muted fs-7" for="acepto-terminos">
                    Acepto los términos y condiciones y autorizo la consulta en centrales de riesgo.
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light" onclick="irPaso(4)">← Volver</button>
                <button type="button" class="btn btn-success flex-grow-1" id="btn-enviar" onclick="enviarSolicitud()">
                    🚀 Enviar Solicitud
                </button>
            </div>
        </div>

        <!-- FINAL -->
        <div class="step-content d-none text-center" id="paso-final">
            <div class="symbol symbol-80px mb-5">
                <span class="symbol-label bg-light-success">
                    <i class="ki-duotone ki-check-circle fs-3x text-success"><span class="path1"></span><span class="path2"></span></i>
                </span>
            </div>
