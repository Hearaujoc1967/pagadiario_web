                        <td><span class="text-dark fw-bold">#{{ p.id }}</span></td>
                        <td><span class="text-dark fw-bold">S/ {{ "{:,.2f}".format(p.monto_prestado|float) }}</span></td>
                        <td><span class="text-danger fw-bold">S/ {{ "{:,.2f}".format(p.saldo) }}</span></td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="text-dark fw-bold me-2 fs-8">{{ p.porcentaje|round(0)|int }}%</span>
                                <div class="progress h-6px w-100">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: {{ p.porcentaje }}%"></div>
                                </div>
                            </div>
                        </td>
                        <td class="text-end">
                            <!-- Detalle no disponible en el portal -->
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center text-muted py-10">
            <i class="ki-duotone ki-information-5 fs-5x text-muted mb-3"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
            <p>No tienes préstamos activos.</p>
        </div>
        {% endif %}
    </div>
</div>




<!-- Botón de cerrar sesión al final -->
<div class="d-flex justify-content-center mt-10 mb-5">
    <a href="{{ url_for('logout') }}" class="btn btn-light-danger btn-lg">
        <i class="ki-duotone ki-entrance-right fs-2"><span class="path1"></span><span class="path2"></span></i>
        Cerrar Sesión
    </a>
</div>

{% endblock %}
