    </div>
</div>

<!-- ESTILOS DEL STEPPER -->
<style>
    .stepper-circle {
        width: 45px; height: 45px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: white; border: 3px solid #e4e6ef; color: #a1a5b7;
        font-weight: 700; font-size: 16px;
        transition: all 0.3s;
    }
    .stepper-circle.active {
        border-color: #7239ea; color: #7239ea;
        box-shadow: 0 0 0 5px rgba(114, 57, 234, 0.1);
    }
    .stepper-circle.done {
        background: #50cd89; border-color: #50cd89; color: white;
    }
    .chip-monto.active, .chip-plazo.active {
        background: #7239ea !important; color: white !important; border-color: #7239ea !important;
    }
    [data-bs-theme="dark"] .stepper-circle {
        background: #1e1e2d; border-color: #2b2b40; color: #6b7280;
    }
    [data-bs-theme="dark"] .stepper-circle.active {
        border-color: #7239ea; color: #b388ff;
    }
</style>

<!-- ============================================== -->
<!-- JAVASCRIPT DEL STEPPER -->
<!-- ============================================== -->
<script>
// ============================================
// ESTADO GLOBAL DEL STEPPER
// ============================================
var state = {
    pasoActual: 1,
    monto: 500000,
    plazo: 30,
    telefono: '',
    email: '',
    ingreso: 0,
    motivo: '',
    banco: '',
    numeroCuenta: '',
    codigoOTP: ''
};

// ============================================
// NAVEGACIÓN ENTRE PASOS
// ============================================
function irPaso(paso) {
    // Ocultar todos los pasos
    for (var i = 1; i <= 5; i++) {
        var el = document.getElementById('paso-' + i);
        if (el) el.classList.add('d-none');
    }
    var elFinal = document.getElementById('paso-final');
    if (elFinal) elFinal.classList.add('d-none');

    // Mostrar el paso solicitado
    if (paso >= 1 && paso <= 5) {
        var el = document.getElementById('paso-' + paso);
        if (el) el.classList.remove('d-none');
    } else if (paso === 6) {
        if (elFinal) elFinal.classList.remove('d-none');
    }

    state.pasoActual = paso;

    // Actualizar círculos
    for (var i = 1; i <= 5; i++) {
        var circle = document.getElementById('step-circle-' + i);
        var text = document.getElementById('step-text-' + i);
        if (!circle) continue;

        circle.classList.remove('active', 'done');
        if (text) text.classList.remove('text-muted');

        if (i < paso) {
            circle.classList.add('done');
            circle.innerHTML = '✓';
        } else if (i === paso) {
            circle.classList.add('active');
        } else {
            if (text) text.classList.add('text-muted');
        }
    }

    // Actualizar barra de progreso
    var progress = document.getElementById('stepper-progress');
    if (progress) {
        var pct = ((paso - 1) / 4) * 100;
        progress.style.width = pct + '%';
    }

    // Si es el paso 5, llenar el resumen
    if (paso === 5) {
        llenarResumenFinal();
    }

    // Scroll arriba
    window.scrollTo({top: 0, behavior: 'smooth'});
}

// ============================================
// PASO 1: COTIZAR - SLIDER Y CHIPS
// ============================================
function actualizarResumen() {
    var monto = state.monto;
    var plazo = state.plazo;
    var interes = monto * 0.20;
    var total = monto + interes;
    var cuota = total / plazo;

    // Formatear
    var fMonto = '$' + monto.toLocaleString('es-CO');
    var fInteres = '$' + Math.round(interes).toLocaleString('es-CO');
    var fTotal = '$' + Math.round(total).toLocaleString('es-CO');
    var fCuota = '$' + Math.round(cuota).toLocaleString('es-CO');

    // Actualizar display principal
    var displayMonto = document.getElementById('display-monto');
    if (displayMonto) displayMonto.textContent = fMonto;

    // Actualizar resumen
    var rMonto = document.getElementById('r-monto');
    if (rMonto) rMonto.textContent = fMonto;

    var rInteres = document.getElementById('r-interes');
    if (rInteres) rInteres.textContent = fInteres;

    var rTotal = document.getElementById('r-total');
    if (rTotal) rTotal.textContent = fTotal;

    var rCuota = document.getElementById('r-cuota');
    if (rCuota) rCuota.textContent = fCuota;
}

function initSlider() {
    var slider = document.getElementById('slider-monto');
    if (slider) {
        slider.addEventListener('input', function() {
            state.monto = parseInt(this.value);
            actualizarResumen();
            // Quitar active de todos los chips
            document.querySelectorAll('.chip-monto').forEach(function(c) {
                c.classList.remove('active');
            });
        });
    }

    // Chips de monto
    document.querySelectorAll('.chip-monto').forEach(function(chip) {
        chip.addEventListener('click', function() {
            var val = parseInt(this.getAttribute('data-val'));
            state.monto = val;
            if (slider) slider.value = val;
            // Marcar chip activo
            document.querySelectorAll('.chip-monto').forEach(function(c) {
                c.classList.remove('active');
            });
            this.classList.add('active');
            actualizarResumen();
        });
    });

    // Chips de plazo
    document.querySelectorAll('.chip-plazo').forEach(function(chip) {
        chip.addEventListener('click', function() {
            var val = parseInt(this.getAttribute('data-val'));
            state.plazo = val;
            document.querySelectorAll('.chip-plazo').forEach(function(c) {
                c.classList.remove('active');
            });
            this.classList.add('active');
            actualizarResumen();
        });
    });
}

// ============================================
// PASO 2: DATOS
// ============================================
function enviarDatos() {
    var telefono = document.getElementById('telefono').value.trim();
    var email = document.getElementById('email').value.trim();
    var ingreso = document.getElementById('ingreso').value.trim();
    var motivo = document.getElementById('motivo').value;

    if (!telefono || !email || !ingreso || !motivo) {
        alert('Por favor completa todos los campos');
        return;
    }

    state.telefono = telefono;
    state.email = email;
    state.ingreso = parseInt(ingreso);
    state.motivo = motivo;
    state.canal = 'whatsapp';  // por defecto
    state.contacto = telefono; // WhatsApp usa teléfono

    // Actualizar display del contacto en el paso 3
    var canalDesc = document.getElementById('canal-descripcion');
    var contactoDisplay = document.getElementById('contacto-display');
    if (canalDesc) canalDesc.innerHTML = 'Enviaremos el código por <strong>WhatsApp</strong> a:';
    if (contactoDisplay) contactoDisplay.textContent = telefono;

    // Reset de pestañas activas
    document.querySelectorAll('.canal-btn').forEach(function(b) { b.classList.remove('active'); });
    var btnWa = document.querySelector('.canal-btn[data-canal="whatsapp"]');
    if (btnWa) btnWa.classList.add('active');

    // NO enviar OTP aquí. Solo entrar al paso 3.
    // El código se envía cuando el usuario elige una pestaña.
    irPaso(3);
}

// ============================================
// PASO 3: SEGURIDAD (OTP)
// ============================================
function generarOTP() {
    // Enviar al backend para que genere y guarde el código
    var formData = new FormData();
    formData.append('dni', document.getElementById('dni').value.trim());
    formData.append('canal', state.canal || 'whatsapp');
    formData.append('contacto', state.contacto || '');

    fetch('/api/enviar_otp', {
        method: 'POST',
        body: formData
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            // En modo dev, guardar el código para debug
            // En modo real, NO se devuelve el código (por seguridad)
            if (data.modo === 'dev' && data.codigo_dev) {
                state.codigoOTP = data.codigo_dev;
                var codigoDev = document.getElementById('codigo-dev');
                if (codigoDev) codigoDev.textContent = state.codigoOTP;
            } else {
                // Mostrar mensaje de éxito y ocultarlo a los 8 segundos
                var bloque = document.getElementById('bloque-envio');
                var mensaje = document.getElementById('mensaje-envio');
                if (bloque && mensaje) {
                    var canalNombre = {whatsapp: 'WhatsApp', sms: 'SMS', email: 'tu correo'}[data.canal] || 'tu ' + data.canal;
                    mensaje.textContent = '¡Código enviado por ' + canalNombre + '! Revisa tu bandeja.';
                    bloque.classList.remove('d-none');
                    setTimeout(function() {
                        bloque.classList.add('d-none');
                    }, 8000);
                }
            }

            // Limpiar inputs (BUG FIX: era inp.monto_prestado)
            for (var i = 1; i <= 6; i++) {
                var inp = document.getElementById('otp-' + i);
                if (inp) inp.value = '';
            }

            // Focus en el primer input
            var otp1 = document.getElementById('otp-1');
            if (otp1) otp1.focus();

            // Iniciar timer
            iniciarTimer();
        } else {
            alert('Error: ' + (data.error || 'No se pudo enviar el código'));
        }
    })
    .catch(function(err) {
        console.error('Error OTP:', err);
        alert('Error de conexión al enviar OTP');
    });
}

function reenviarOTP() {
    // Llamar al backend para enviar un nuevo código
    generarOTP();
}

function iniciarTimer() {
    var seg = 45;
    var timerEl = document.getElementById('timer-otp');
    if (!timerEl) return;

    var interval = setInterval(function() {
        seg--;
        timerEl.textContent = '(' + seg + 's)';
        if (seg <= 0) {
            clearInterval(interval);
            timerEl.textContent = '(Disponible)';
        }
    }, 1000);
}

function verificarOTP() {
    var codigoIngresado = '';
    for (var i = 1; i <= 6; i++) {
        var inp = document.getElementById('otp-' + i);
        if (inp) codigoIngresado += inp.value;
    }

    if (codigoIngresado.length !== 6) {
        alert('Debes ingresar los 6 dígitos');
        return;
    }

    // Validar contra el backend
    var formData = new FormData();
    formData.append('dni', document.getElementById('dni').value.trim());
    formData.append('codigo', codigoIngresado);

    fetch('/api/verificar_otp', {
        method: 'POST',
        body: formData
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            irPaso(4);
        } else {
            alert('Código incorrecto. Intenta de nuevo.');
        }
    })
    .catch(function(err) {
        console.error('Error verificando OTP:', err);
        alert('Error de conexión al verificar el código');
    });
}

// ============================================
// PESTAÑAS DE CANAL OTP
// ============================================
function initCanalTabs() {
    var btns = document.querySelectorAll('.canal-btn');
    if (!btns.length) return;

    btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var canal = this.getAttribute('data-canal');
            state.canal = canal;

            // Actualizar clase activa
            btns.forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');

            // Actualizar descripción y contacto
            var desc = document.getElementById('canal-descripcion');
            var disp = document.getElementById('contacto-display');

            if (canal === 'whatsapp') {
                if (desc) desc.innerHTML = 'Enviaremos el código por <strong>WhatsApp</strong> a:';
                if (disp) disp.textContent = state.telefono || '-';
                state.contacto = state.telefono;
            } else if (canal === 'sms') {
                if (desc) desc.innerHTML = 'Enviaremos el código por <strong>SMS</strong> a:';
                if (disp) disp.textContent = state.telefono || '-';
                state.contacto = state.telefono;
            } else if (canal === 'email') {
                if (desc) desc.innerHTML = 'Enviaremos el código por <strong>Email</strong> a:';
                if (disp) disp.textContent = state.email || '-';
                state.contacto = state.email;
            }

            // Enviar el código al pulsar la pestaña
            generarOTP();
        });
    });
}

// Auto-focus en inputs OTP
function initOTP() {
    for (var i = 1; i <= 6; i++) {
        (function(idx) {
            var inp = document.getElementById('otp-' + idx);
            if (!inp) return;

            inp.addEventListener('input', function() {
                if (this.value.length >= 1 && idx < 6) {
                    var next = document.getElementById('otp-' + (idx + 1));
                    if (next) next.focus();
                }
            });

            inp.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace' && !this.value && idx > 1) {
                    var prev = document.getElementById('otp-' + (idx - 1));
                    if (prev) prev.focus();
                }
            });
        })(i);
    }
}

// ============================================
// PASO 4: BANCO
// ============================================
function enviarBanco() {
    var banco = document.querySelector('input[name="banco"]:checked');
    var numeroCuenta = document.getElementById('numero-cuenta').value.trim();

    if (!banco) {
        alert('Por favor selecciona un banco');
        return;
    }
    if (!numeroCuenta) {
        alert('Por favor ingresa el número de cuenta');
        return;
    }

    state.banco = banco.value;
    state.numeroCuenta = numeroCuenta;

    irPaso(5);
}

// ============================================
// PASO 5: CONFIRMAR
// ============================================
function llenarResumenFinal() {
    var interes = state.monto * 0.20;
    var total = state.monto + interes;
    var cuota = total / state.plazo;

    var confMonto = document.getElementById('conf-monto');
    if (confMonto) confMonto.textContent = '$' + state.monto.toLocaleString('es-CO');

    var confPlazo = document.getElementById('conf-plazo');
    if (confPlazo) confPlazo.textContent = state.plazo + ' días';

    var confCuota = document.getElementById('conf-cuota');
    if (confCuota) confCuota.textContent = '$' + Math.round(cuota).toLocaleString('es-CO');

    var confTotal = document.getElementById('conf-total');
    if (confTotal) confTotal.textContent = '$' + Math.round(total).toLocaleString('es-CO');

    var confBanco = document.getElementById('conf-banco');
    if (confBanco) confBanco.textContent = state.banco + ' - ' + state.numeroCuenta;
}

// ============================================
// TOAST GENÉRICO
// ============================================
var toastTimer = null;

function mostrarToast(titulo, mensaje, tipo, duracion) {
    tipo = tipo || 'advertencia';
    duracion = duracion || 10000;

    var toast = document.getElementById('toast-generico');
    if (!toast) return;

    // Limpiar timer previo
    if (toastTimer) { clearTimeout(toastTimer); toastTimer = null; }

    // Asignar contenido
    document.getElementById('toast-titulo').innerText = titulo;
    document.getElementById('toast-mensaje').innerText = mensaje;

    // Asignar clase de tipo
    toast.classList.remove('toast-advertencia', 'toast-exito', 'toast-error');
    toast.classList.add('toast-' + tipo);

    // Ícono según tipo
    var icon = document.getElementById('toast-icon');
    if (icon) {
        icon.classList.remove('ki-information-5', 'ki-check-circle', 'ki-cross-circle');
        if (tipo === 'exito')    icon.classList.add('ki-check-circle');
        else if (tipo === 'error') icon.classList.add('ki-cross-circle');
        else                       icon.classList.add('ki-information-5');
    }

    // Mostrar
    toast.style.display = 'block';
    setTimeout(function() { toast.classList.add('toast-visible'); }, 10);

    // Auto-cerrar
    toastTimer = setTimeout(function() { cerrarToast(); }, duracion);
}

function cerrarToast() {
    var toast = document.getElementById('toast-generico');
    if (!toast) return;
    toast.classList.remove('toast-visible');
    setTimeout(function() { toast.style.display = 'none'; }, 300);
    if (toastTimer) { clearTimeout(toastTimer); toastTimer = null; }
}

// Cerrar al pulsar en cualquier parte de la pantalla
document.addEventListener('click', function(e) {
    var toast = document.getElementById('toast-generico');
    if (!toast || toast.style.display === 'none') return;
    // Si el click NO fue dentro del toast, cerrarlo
    if (!toast.contains(e.target)) {
        cerrarToast();
    }
});

function enviarSolicitud() {
    var acepto = document.getElementById('acepto-terminos');
    if (!acepto || !acepto.checked) {
        alert('Debes aceptar los términos y condiciones');
        return;
    }

    // Preparar datos
    var formData = new FormData();
    formData.append('monto', state.monto);
    formData.append('plazo', state.plazo);
    formData.append('telefono', state.telefono);
    formData.append('email', state.email);
    formData.append('ingreso', state.ingreso);
    formData.append('motivo', state.motivo);
    formData.append('banco', state.banco);
    formData.append('numero_cuenta', state.numeroCuenta);

    // Enviar a Flask
    fetch('/solicitar_prestamo_paso', {
        method: 'POST',
        body: formData
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (data.success) {
            if (data.advertencia) {
                mostrarToast(
                    'Solicitud enviada',
                    'NOTA: ' + data.advertencia + ' Tu solicitud quedará registrada y el administrador la revisará.',
                    'advertencia',
                    10000
                );
            } else {
                mostrarToast(
                    '¡Solicitud enviada!',
                    'Tu solicitud fue enviada correctamente. El administrador la revisará.',
                    'exito',
                    8000
                );
            }
            irPaso(6);
        } else {
            mostrarToast('Error', data.error || 'No se pudo enviar la solicitud', 'error', 10000);
        }
    })
    .catch(function(err) {
        alert('Error de conexión: ' + err.message);
    });
}

// ============================================
// INICIALIZACIÓN
// ============================================
document.addEventListener('DOMContentLoaded', function() {
    initSlider();
    initOTP();
    initCanalTabs();
    actualizarResumen();
    irPaso(1);

});
</script>


